# Never copy production database credentials into this file.
# Use a separate Supabase project created specifically for staging/UAT.
STAGING_DATABASE_URL="postgresql://postgres.STAGING_PROJECT_REF:STAGING_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
STAGING_DIRECT_URL="postgresql://postgres.STAGING_PROJECT_REF:STAGING_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"
STAGING_PROJECT_REF="STAGING_PROJECT_REF"
PRODUCTION_PROJECT_REF="PRODUCTION_PROJECT_REF"

# Application values for the Vercel Staging environment.
DATABASE_URL="same value as STAGING_DATABASE_URL"
DIRECT_URL="same value as STAGING_DIRECT_URL"
JWT_SECRET="generate a new staging-only 64-byte random secret"
BUSINESS_TZ="Asia/Seoul"
NEXT_PUBLIC_APP_URL="https://YOUR-STABLE-STAGING-DOMAIN"

# Keep push disabled from UAT workflows until separate staging credentials exist.
# A Vercel production-runtime preview rejects mock mode, so either configure real
# staging push credentials with live mode or do not trigger notification flows.
NOTIFICATIONS_MODE="live"
