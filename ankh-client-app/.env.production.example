# Copy this file to your Vercel/deployment platform environment variables
# Replace all placeholder values with your actual credentials

# Supabase Database URLs
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres"

# JWT Secret (IMPORTANT: Generate a secure random string!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_jwt_secret_here"

# Next.js Environment
NODE_ENV="production"

# ── Scheduling ────────────────────────────────────────────────────────────────
# IANA time zone the studio's business hours are defined in (slot generation).
BUSINESS_TZ="Asia/Seoul"

# ── Native push notifications ─────────────────────────────────────────────────
# Production fails closed unless this is "live". Use "mock" only for local
# development and automated tests.
NOTIFICATIONS_MODE="live"

# Push via Firebase Cloud Messaging (covers Android/FCM and iOS/APNs when the
# iOS app is registered in the same Firebase project). Paste the full
# service-account JSON as one line. SERVER-SIDE ONLY — never expose to clients.
# FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}'

# iOS delivery uses APNs directly. Store the .p8 key with literal \n escapes
# when your deployment platform requires a single-line environment value.
APNS_TEAM_ID="YOUR_APPLE_TEAM_ID"
APNS_KEY_ID="YOUR_APNS_KEY_ID"
APNS_BUNDLE_ID_CLIENT="com.ankh.clientportal"
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_ENVIRONMENT="production"

# ── Client portal native shell ────────────────────────────────────────────────
# The client shell's WebView URL is set in
# ankh-client-portal-shell/capacitor.config.json (server.url) — edit it there
# if the deployment URL changes.
